<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="HDFC_LOAN_APPLICATION.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>

  
</head>
<body>
    <form id="form1" runat="server">
    <table border="1" width="100%" length="100%">

        <tr>
             <td colspan="5" >
               <h1 align="center">HDFC Loans -Next Step to Dream</h1>
             </td>
        </tr>
        <tr  >
             <td colspan="4">
                 <p>Logged In: </p>
             </td>
             <td >
            <p style="text-align:center">
                 <asp:Button ID="Button1" runat="server" Text="Button" Width="100%" />

            </p>


             </td>
        </tr>
        <tr >
             <td> 
            <p style="text-align:center">
                <a href="home.aspx">Home</a>

            </p>
             </td>
             <td> 
            <p style="text-align:center">
           <a href="newapp.aspx">New Application</a>

            </p>                 

             </td>
             <td>     
            <p style="text-align:center">
           <a href="upapp.aspx">Update Application</a>

            </p>
             </td>
             <td>     
            <p style="text-align:center">
           <a href="disapp.aspx">Remove Application</a>

            </p>
             </td>
             <td>     
            <p style="text-align:center">
           <a href="view.aspx">View All</a>

            </p>
             </td>
        </tr>

        <tr>
            <td colspan="5">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>

            </td>

        </tr>

        <tr>
            <td colspan="5">
                <h2>Contact Us :</h2>
                <p>HDFC Loans Systems,</p>
                <p>Mumbai, Maharashtra India</p>


                <p align="center">&copy; <%: DateTime.Now.Year %> - HDFC BANK</p>

            </td>

        </tr>

    </table>

    </form>

</body>
</html>
